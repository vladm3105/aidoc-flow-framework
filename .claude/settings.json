{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/plan-review-gate.sh\"",
            "if": "Bash(git commit*)",
            "timeout": 15,
            "statusMessage": "Checking plan review log"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-handoff.sh\"",
            "timeout": 15,
            "statusMessage": "Loading migration handoff record"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-compact-snapshot.sh\"",
            "timeout": 120,
            "statusMessage": "Snapshotting uncommitted work before compaction"
          }
        ]
      }
    ]
  }
}
