# =============================================================================
# RAG Services .gitignore
# =============================================================================

# Environment files (contain secrets)
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary files
tmp/
*.tmp
*.temp
*.log

# Backups (can be large)
backups/

# Data directories (managed by Docker volumes)
haystack/data/
lightrag/data/
lightrag/inputs/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Docker
*.log

# OS files
.DS_Store
Thumbs.db

# Secrets
*.pem
*.key
credentials.json
