{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${AIDOC_ROOT:-.}/hooks/sdd-doc-review.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCommit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${AIDOC_ROOT:-.}/hooks/ch-gate-check.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
