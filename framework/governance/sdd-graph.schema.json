{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Native SDD Graph Schema",
  "description": "Canonical schema for Specification-Driven Development (SDD) Native Property Graphs",
  "type": "object",
  "required": ["schema_version", "slice_id", "metadata", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["2.0-graph"]
    },
    "slice_id": {
      "type": "string",
      "pattern": "^(INIT|MODULE|IPLAN|EXEC)-([a-zA-Z0-9_-]+|NN_\\[[a-zA-Z0-9_-]+\\])$"
    },
    "initiative_ref": {
      "type": "string"
    },
    "module_ref": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "required": ["author", "last_updated", "status", "framework_version"],
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string" },
        "created_date": { "type": "string" },
        "last_updated": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["Draft", "Active", "Deprecated", "Superseded"]
        },
        "framework_version": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(@[a-zA-Z0-9_-]+:)?([A-Z]{3,4}\\.[0-9]{2}\\.[0-9]{2}\\.[a-f0-9x]{4}|TASK\\.[0-9]{2}\\.[0-9]{2}\\.[a-f0-9x]{4}(_rollback)?|CHG-[0-9]{2,3}|SEED-[a-zA-Z0-9_-]+|MODULE-[0-9]{2})$"
          },
          "type": {
            "type": "string",
            "enum": [
              "seed_intent",
              "system_container",
              "business_objective",
              "product_capability",
              "formal_requirement",
              "acceptance_scenario",
              "architectural_decision",
              "component_contract",
              "test_fixture",
              "task_action",
              "change_request"
            ]
          },
          "title": { "type": "string" },
          "statement": { "type": "string" },
          "pattern": {
            "type": "string",
            "enum": ["ubiquitous", "event_driven", "state_driven", "optional", "unwanted"]
          },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" },
          "context": { "type": "string" },
          "decision": { "type": "string" },
          "consequences": { "type": "string" },
          "target_file": { "type": "string" },
          "command": { "type": "string" },
          "action": { "type": "string" },
          "compensation": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["Draft", "Proposed", "Active", "Accepted", "Rejected", "Deprecated", "Superseded"]
          },
          "supersedes": { "type": "string" },
          "authorized_by": { "type": "string" },
          "properties": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "relation"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "relation": {
            "type": "string",
            "enum": [
              "decomposes_to",
              "realizes",
              "verifies",
              "proves",
              "constrains",
              "implements",
              "compensated_by",
              "authorized_by",
              "supersedes"
            ]
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
