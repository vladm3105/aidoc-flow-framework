# ============================================================
# Automation Framework — Environment Configuration Template
# ============================================================
# Copy this file to .env in your project root and fill in values.
# NEVER commit .env with real secrets to git.

# ============================================================
# AI Agent Selection (choose one)
# ============================================================
AI_AGENT=claude           # claude | opencode | codex | cline | ollama | openai-api | gemini
AI_MODEL=                 # optional: leave blank for agent default

# ============================================================
# GitHub Integration
# ============================================================
GH_TOKEN=                 # GitHub Personal Access Token (needs: repo, issues, project scopes)
GH_REPO=owner/repo-name   # target repo for GitHub Issues creation
GH_PROJECT=               # GitHub Project board number (optional, e.g. 1)

# ============================================================
# OpenAI-compatible API (only if AI_AGENT=openai-api)
# ============================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================
# Knowledge Base (only if KB services are running)
# ============================================================
KB_ENABLED=false

# PostgreSQL / pgvector (RAG)
DATABASE_URL=postgresql://user:pass@localhost:5432/knowledge_db
RAG_SCHEMA=rag

# Neo4j (Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=
NEO4J_DATABASE=neo4j

# ============================================================
# Pipeline Behaviour
# ============================================================
DRY_RUN=false             # set to true to preview without making changes
AUTO_APPLY_ENABLED=true   # auto-apply structural P0 fixes to source docs
AUTO_APPLY_COMMIT=true    # git commit auto-applied fixes
