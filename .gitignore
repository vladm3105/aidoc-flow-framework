# Temporary files
tmp/

# Test-run log directories (per-run dirs keyed by ISO timestamp).
# Fixture-driven suites land here:
tests/logs/
# Example-driven suites land under each example:
examples/*/logs/

# Work plans (local planning documents)
work_plans/

# BMAD commands (external module)
.claude/commands/bmad/

# Python bytecode
*.pyc
__pycache__/
*.pyo
*.pyd
ai_dev_flow/scripts/__pycache__

# Testing
.pytest_cache/
.coverage
htmlcov/
tests/coverage_html/
tests/results/*.json
!tests/results/baseline_*.json
tests/results/archive/
*.pytest_cache

# Coverage reports
coverage.xml
*.cover
.hypothesis/
.venv/

# Review-team blackboard — transient per-persona slots (plans/DECISIONS.md D-0005).
# The committed adaptation profile (.aidoc/profile.yaml) is NOT ignored.
# Per ACCEPTANCE-SUITE-FIXES-PLAN.md §2: only the transient blackboard is
# gitignored; final consensus reports under .aidoc/review/ are committed
# as part of the AI provenance documentation tier.
.aidoc/review/.blackboard/

# Generated publish artifacts — the plugin mirror is a one-way build output
# (tools/build-plugin-mirror.sh, PLUGIN-MARKETPLACE P2), never committed here.
dist/

# Governed CHG archives under framework/archive/CHG-*/ must stay tracked
# (donor §3.6b trap: a blanket archive/ rule would swallow them — never add one).
# The negation below is a no-op today (no rule ignores them) and guards the
# governed scope only — never broaden to !archive/**.
!framework/archive/CHG-*/

# --- aidoc-flow-ci canon baseline (PLAN-002 §10.1) ---
.claude/
.review/
scratch/
.env
.env.*
!.env.example
.mypy_cache/
.ruff_cache/
build/
*.egg-info/
node_modules/
.DS_Store
.vscode/
.idea/
Thumbs.db
