{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/vladm3105/aidoc-flow-framework/tests/scripts/test-acceptance.schema.json",
  "title": "Acceptance test summary + per-element schemas (v1.2)",
  "description": "Schemas for the artifacts produced by tests/scripts/test-acceptance.sh. v1.2 adds RUNNING (in-flight) and INTERRUPTED (kill/abort before terminal) outcomes for resume support. v1.1 introduced the combined YAML front-matter + raw stdout layout. See examples/url-shortener/ACCEPTANCE_TEST_PLAN.md §3.",
  "definitions": {
    "outcome": {
      "type": "string",
      "enum": ["PASS", "FAIL", "SKIP", "RUNNING", "INTERRUPTED"]
    },
    "kind": {
      "type": "string",
      "enum": ["skill", "agent", "command", "hook", "fixture"]
    },
    "phase": {
      "type": "string",
      "enum": ["bootstrap", "cascade", "negative", "chg", "utilities", "agents", "command", "hook"]
    },
    "element": {
      "type": "object",
      "required": ["schema_version", "name", "kind", "phase", "outcome"],
      "properties": {
        "schema_version": {"type": "string", "const": "1.2"},
        "name": {"type": "string"},
        "kind": {"$ref": "#/definitions/kind"},
        "phase": {"$ref": "#/definitions/phase"},
        "duration_sec": {"type": "number", "minimum": 0},
        "outcome": {"$ref": "#/definitions/outcome"},
        "audit_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "audit_score_after_fixer": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "fixer_invoked": {"type": "boolean"},
        "output_path": {"type": ["string", "null"], "description": "Path to the artifact this element produced: docs/ for layer artifacts, .aidoc/<category>/ for provenance reports, logs/<TS>/sandbox/ for tmp work."},
        "tokens_in": {"type": ["integer", "null"], "minimum": 0},
        "tokens_out": {"type": ["integer", "null"], "minimum": 0},
        "error": {"type": ["string", "null"]}
      }
    },
    "summary": {
      "type": "object",
      "required": ["schema_version", "run_id", "example", "outcome", "elements"],
      "properties": {
        "schema_version": {"type": "string", "const": "1.2"},
        "run_id": {"type": "string", "description": "LOG_TIMESTAMP keying logs/<TS>/"},
        "example": {"type": "string"},
        "plugin_version": {"type": ["string", "null"]},
        "framework_spec_version": {"type": ["string", "null"]},
        "outcome": {"$ref": "#/definitions/outcome"},
        "counts": {
          "type": "object",
          "properties": {
            "PASS": {"type": "integer", "minimum": 0},
            "FAIL": {"type": "integer", "minimum": 0},
            "SKIP": {"type": "integer", "minimum": 0}
          }
        },
        "elements": {
          "type": "array",
          "items": {"$ref": "#/definitions/element"}
        }
      }
    }
  },
  "oneOf": [
    {"$ref": "#/definitions/summary"},
    {"$ref": "#/definitions/element"}
  ]
}
