{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/vladm3105/aidoc-flow-framework/tests/scripts/test-acceptance.schema.json",
  "title": "Acceptance test summary + per-element metadata schemas (v1.0)",
  "description": "Schemas for the artifacts produced by tests/scripts/test-acceptance.sh. See examples/url-shortener/ACCEPTANCE_TEST_PLAN.md §3.1.",
  "definitions": {
    "outcome": {
      "type": "string",
      "enum": ["PASS", "FAIL", "SKIP"]
    },
    "kind": {
      "type": "string",
      "enum": ["skill", "agent", "command", "hook", "fixture"]
    },
    "phase": {
      "type": "string",
      "enum": ["bootstrap", "cascade", "negative", "chg", "utilities", "agents", "command", "hook"]
    },
    "element": {
      "type": "object",
      "required": ["schema_version", "name", "kind", "phase", "outcome"],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0"},
        "name": {"type": "string"},
        "kind": {"$ref": "#/definitions/kind"},
        "phase": {"$ref": "#/definitions/phase"},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "duration_sec": {"type": "number", "minimum": 0},
        "exit_code": {"type": "integer"},
        "outcome": {"$ref": "#/definitions/outcome"},
        "tokens_in": {"type": ["integer", "null"], "minimum": 0},
        "tokens_out": {"type": ["integer", "null"], "minimum": 0},
        "output_path": {"type": ["string", "null"]},
        "audit_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "audit_score_after_fixer": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
        "fixer_invoked": {"type": "boolean"},
        "error": {"type": ["string", "null"]}
      }
    },
    "summary": {
      "type": "object",
      "required": ["schema_version", "run_id", "example", "outcome", "elements"],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0"},
        "run_id": {"type": "string", "description": "LOG_TIMESTAMP keying logs/<TS>/"},
        "example": {"type": "string", "description": "Example name (e.g. url-shortener)"},
        "plugin_version": {"type": "string"},
        "framework_spec_version": {"type": "string"},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "duration_sec": {"type": "number", "minimum": 0},
        "live": {"type": "boolean"},
        "mock_source": {"type": ["string", "null"], "description": "Path to logs/<TS>/ being replayed; null if not in --mock mode"},
        "bootstrap_mode": {"type": "boolean", "description": "True if examples/<NAME>/docs/ was empty at run start"},
        "promoted": {"type": "boolean"},
        "outcome": {"$ref": "#/definitions/outcome"},
        "tokens_in_total": {"type": "integer", "minimum": 0},
        "tokens_out_total": {"type": "integer", "minimum": 0},
        "elements": {
          "type": "array",
          "items": {"$ref": "#/definitions/element"}
        }
      }
    }
  },
  "oneOf": [
    {"$ref": "#/definitions/summary"},
    {"$ref": "#/definitions/element"}
  ]
}
