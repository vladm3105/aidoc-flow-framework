# =============================================================================
# RAG Services Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# =============================================================================
# Project Configuration (Required)
# =============================================================================

# Path to your project root directory
# Data will be stored in: ${PROJECT_ROOT}/tools/data/
# Example: /opt/data/my_project
PROJECT_ROOT=/path/to/your/project

# =============================================================================
# API Keys (Required)
# =============================================================================

# OpenAI API Key - Used for embeddings and LLM generation
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Cohere API Key - Used for reranking (optional but recommended)
# Get from: https://dashboard.cohere.com/api-keys
# Free tier: 1000 calls/month
COHERE_API_KEY=your-cohere-api-key-here

# =============================================================================
# Database Credentials
# =============================================================================

# PostgreSQL password
POSTGRES_PASSWORD=ragpass

# Neo4j password (minimum 8 characters)
NEO4J_PASSWORD=neo4jpass

# LightRAG API key (for REST API authentication)
LIGHTRAG_API_KEY=lightragsecretkey

# =============================================================================
# Optional: Alternative Embedding Providers
# =============================================================================

# Jina API Key (alternative reranker)
# JINA_API_KEY=your-jina-api-key-here

# =============================================================================
# Optional: Local LLM Configuration (Ollama)
# =============================================================================

# Uncomment to use local LLM instead of OpenAI
# OLLAMA_HOST=http://host.docker.internal:11434
# LLM_MODEL=qwen2.5:32b
# EMBEDDING_MODEL=nomic-embed-text
